APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Storefront base URL used for admin-logout / admin guest redirects.
# Leave empty when the SPA is served from the same origin (production);
# set to e.g. http://localhost:5173 in development.
FRONTEND_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Admin password used by AdminUserSeeder ONLY on first-time creation.
# Existing admins keep their password on re-seed. Leave unset (commented
# out) for the default (admin123). Note: an empty value (ADMIN_PASSWORD=)
# is treated as an empty password, not the default.
# ADMIN_PASSWORD=admin123

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# For structured JSON logging in production (json or json_daily):
# LOG_CHANNEL=json_daily
# LOG_JSON_DAYS=30

# Docker / Queue
QUEUE_WORKER=true

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sh_store
# DB_USERNAME=sh_store
# DB_PASSWORD=secret
# DB_ROOT_PASSWORD=root_secret

CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173,http://127.0.0.1:8000,http://127.0.0.1:5173

# Sentry error monitoring (optional — leave blank to disable)
SENTRY_DSN=
SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

# ── Redis (used for cache, sessions, and queue) ──
# Setting REDIS_CLIENT=predis uses the pure-PHP Redis client
# so no PHP extension is required. Works out of the box.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Cache ──
# Switch to redis for ~100x faster reads/writes compared to database driver
CACHE_STORE=redis
# Prefix all cache keys to avoid collisions with other apps
CACHE_PREFIX=sh_store

# ── Session ──
# Redis sessions are much faster than database/file and scale horizontally
SESSION_DRIVER=redis
SESSION_CONNECTION=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Queue ──
# Redis queue is non-blocking and much faster than database polling
QUEUE_CONNECTION=redis

# ── Broadcasting ──
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Docker compose port overrides:
# NGINX_PORT=80
# NGINX_SSL_PORT=443
# FRONTEND_PORT=5173

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MONTHLY_REVENUE_TARGET=10000

STRIPE_KEY=your_stripe_key
STRIPE_SECRET=your_stripe_secret
STRIPE_WEBHOOK_SECRET=your_webhook_secret

# ── CDN (Cloudflare recommended) ──
# Set your CDN base URL here (e.g. https://cdn.yourdomain.com)
# Used for serving static assets through the CDN
CDN_URL=

# Cloudflare API credentials (for cache purging)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
